# ==========================================
# QUICKDESK .gitignore
# ==========================================

# -------------------------
# Environment variables
# -------------------------
.env
.env.local
.env.*.local

# Keep example environment file
!.env.example


# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*$py.class

*.so

.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/


# -------------------------
# FastAPI / Application
# -------------------------
*.log

# Local databases
*.db
*.sqlite
*.sqlite3


# -------------------------
# RAG / ML generated files
# -------------------------
vectorstore/
chroma/
faiss_index/

*.pkl
*.pickle
*.npy
*.npz

# Sentence transformer cache
.cache/
.huggingface/


# -------------------------
# Node / React
# -------------------------
node_modules/

npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

dist/

.vite/


# -------------------------
# IDE / Editors
# -------------------------
.vscode/
.idea/

*.swp
*.swo

# Windows
Thumbs.db
Desktop.ini


# -------------------------
# OS files
# -------------------------
.DS_Store


# -------------------------
# Temporary files
# -------------------------
*.tmp
*.temp
*.bak


# -------------------------
# Secrets / certificates
# -------------------------
*.pem
*.key
*.crt


# -------------------------
# Build / cache
# -------------------------
.cache/
.parcel-cache/


# -------------------------
# Playwright / browser
# -------------------------
playwright-report/
test-results/


# -------------------------
# Environment-specific
# -------------------------
coverage/